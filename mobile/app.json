{
  "expo": {
    "name": "Daywell",
    "slug": "daywell-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "scheme": "daywell",
    "ios": { "supportsTablet": true, "bundleIdentifier": "app.daywell.mobile" },
