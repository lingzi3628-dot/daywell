# Neon: use the pooled connection URL for serverless/hosted app traffic.
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@YOUR-POOLER-HOST/DB?sslmode=require"
# Optional direct connection URL for migration tooling.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-HOST/DB?sslmode=require"

# Generate a unique random value of at least 32 characters for production.
ENCRYPTION_KEY="replace-with-a-random-secret-at-least-32-characters"

# Optional shared AI access. Users can also connect their own provider in Settings.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Optional maximum database connections per app instance.
DATABASE_POOL_MAX="5"
